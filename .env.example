# .env.example — copy to .env.local and fill in values.
# .env.local is never committed (covered by .gitignore).
#
# Generate a new secret with:
#   openssl rand -hex 32
#
# All variables are optional for local dev (the app runs without them),
# but REVALIDATE_SECRET is required for the Docker container to correctly
# bust the Next.js route cache on startup.

REVALIDATE_SECRET=
