{
  "name": "command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "npx tsx db/seed.ts",
    "seed:projects": "npx tsx db/seed-projects.ts",
    "seed:settings": "npx tsx db/seed-settings.ts",
    "db:checkpoint": "npx tsx scripts/checkpoint-db.ts",
    "db:export-seeds": "npx tsx scripts/export-seeds.ts",
    "db:pull-sync": "npx drizzle-kit migrate",
    "db:commit": "npm run db:checkpoint && git add db/",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:rebuild": "docker compose build && docker compose up -d"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^1.6.0",
    "mermaid": "^11.13.0",
    "next": "15.5.14",
    "node-cron": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.14",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
